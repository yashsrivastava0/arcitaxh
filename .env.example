# Names only. Never commit values. Copy to .env (gitignored) and fill locally.
# The app refuses to start when a required variable is missing (specification 9.6, 14.3).

# --- environment ---
APP_ENV=
APP_BASE_URL=

# --- database ---
# Pooled connection for ordinary requests.
DATABASE_URL=
# Direct (non-pooled) connection. Declared now; used by LISTEN/NOTIFY streaming in Phase 2.
DATABASE_DIRECT_URL=

# --- model access (the fake client is the default everywhere) ---
# Real model calls need ALLOW_REAL_LLM=1 AND a spend cap in config/phase0.json.
ALLOW_REAL_LLM=
LLM_GATEWAY=
LLM_GATEWAY_KEY=
# Direct provider keys, only if a direct adapter is ever used.
PROVIDER_OPENAI_KEY=
PROVIDER_GOOGLE_KEY=
PROVIDER_ANTHROPIC_KEY=
# Path to the pinned roster file in the repository.
MODEL_ROSTER_FILE=

# --- knowledge base ---
# Optional: force a release for debugging.
KB_RELEASE_PIN=

# --- local PostgreSQL container (infra/docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host port; defaults to 5433 so it does not clash with another PostgreSQL on 5432.
POSTGRES_PORT=
