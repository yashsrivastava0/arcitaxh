{
  "name": "decision-canvas",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Decision-Native Architecture Canvas (working name). Phase 0: validate the engine.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "docs:index": "tsx tools/docs-index/src/cli.ts --write",
    "docs:check": "tsx tools/docs-index/src/cli.ts --check",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "check:boundaries": "depcruise packages apps tools --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:core": "vitest run packages/core",
    "licences:check": "tsx tools/licences/src/cli.ts",
    "notices": "tsx tools/notices/src/cli.ts",
    "notices:check": "tsx tools/notices/src/cli.ts --check",
    "secrets:scan": "tsx tools/secret-scan/src/cli.ts",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "ci": "pnpm typecheck && pnpm lint && pnpm check:boundaries && pnpm test:core && pnpm test && pnpm kb:check && pnpm kb:schema:check && pnpm audit:prod && pnpm secrets:scan && pnpm licences:check && pnpm notices:check && pnpm docs:check",
    "kb:check": "tsx tools/kb-check/src/cli.ts check && tsx tools/kb-check/src/cli.ts check --fixtures",
    "kb:sweep": "tsx tools/kb-check/src/cli.ts sweep",
    "kb:build": "tsx tools/kb-build/src/cli.ts build",
    "kb:schema": "tsx tools/kb-build/src/cli.ts schema",
    "kb:schema:check": "tsx tools/kb-build/src/cli.ts schema --check",
    "kb:propose": "tsx tools/kb-propose/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  }
}
